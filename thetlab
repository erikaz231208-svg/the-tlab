// ─── MODAL FORM ───────────────────────────────
function RegisterModal({ plan, onClose }) {
  const [form, setForm] = useState({ name: "", phone: "", note: "" });
  const [status, setStatus] = useState("idle"); // idle | loading | success | error
  const [errors, setErrors] = useState({});

  const validate = () => {
    const e = {};
    if (!form.name.trim()) e.name = "Vui lòng nhập họ tên";
    if (!form.phone.trim()) e.phone = "Vui lòng nhập số điện thoại";
    else if (!/^(0|\+84)[0-9]{8,10}$/.test(form.phone.replace(/\s/g, "")))
      e.phone = "Số điện thoại không hợp lệ";
    return e;
  };

  const handleSubmit = async () => {
    const e = validate();
    if (Object.keys(e).length) { setErrors(e); return; }
    setStatus("loading");
    try {
      const res = await fetch(FORMSPREE_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({
          "Họ tên": form.name,
          "Số điện thoại": form.phone,
          "Gói đăng ký": plan?.label || "Chưa chọn",
          "Giá": plan ? fmt(plan.price) : "—",
          "Ghi chú": form.note || "Không có",
          "Thời gian": new Date().toLocaleString("vi-VN"),
        }),
      });
      if (res.ok) setStatus("success");
      else setStatus("error");
    } catch {
      setStatus("error");
    }
  };

  return (
    <div style={{
      position: "fixed", inset: 0, zIndex: 1000,
      background: "rgba(0,0,0,0.75)", backdropFilter: "blur(6px)",
      display: "flex", alignItems: "center", justifyContent: "center",
      padding: 20,
    }} onClick={onClose}>
      <div style={{
        background: "#12161F", border: "1.5px solid #1E2540",
        borderRadius: 24, padding: "36px 32px", width: "100%", maxWidth: 480,
        boxShadow: "0 24px 80px rgba(0,0,0,0.6)",
        position: "relative",
      }} onClick={e => e.stopPropagation()}>

        {/* Close */}
        <button onClick={onClose} style={{
          position: "absolute", top: 18, right: 18,
          background: "#1E2540", border: "none", color: "#8B9FC4",
          width: 32, height: 32, borderRadius: "50%", cursor: "pointer",
          fontSize: 16, display: "flex", alignItems: "center", justifyContent: "center",
        }}>✕</button>

        {status === "success" ? (
          <div style={{ textAlign: "center", padding: "20px 0" }}>
            <div style={{ fontSize: 56, marginBottom: 16 }}>✅</div>
            <h3 style={{ color: "#4ECCA3", fontSize: 22, fontWeight: 800, margin: "0 0 10px" }}>
              Đăng ký thành công!
            </h3>
            <p style={{ color: "#8B9FC4", fontSize: 14, lineHeight: 1.6, margin: "0 0 24px" }}>
              Chúng tôi đã nhận được thông tin của bạn.<br />
              Mentor sẽ liên hệ qua số điện thoại trong vòng <strong style={{ color: "#E8EAF0" }}>24 giờ</strong>.
            </p>
            <button onClick={onClose} style={{
              background: "linear-gradient(135deg, #4ECCA3, #2A9D8F)",
              color: "#0A0D14", border: "none", borderRadius: 12,
              padding: "12px 32px", fontWeight: 700, fontSize: 14, cursor: "pointer",
            }}>Đóng</button>
          </div>
        ) : (
          <>
            <div style={{ marginBottom: 24 }}>
              <div style={{ fontSize: 12, fontWeight: 700, letterSpacing: "0.12em", textTransform: "uppercase", color: "#4ECCA3", marginBottom: 6 }}>
                Đăng ký tư vấn
              </div>
              <h2 style={{ margin: 0, fontSize: 22, fontWeight: 800 }}>
                The TLab Mentorship
              </h2>
              {plan && (
                <div style={{
                  marginTop: 12, padding: "10px 16px",
                  background: "rgba(78,204,163,0.08)", border: "1px solid rgba(78,204,163,0.2)",
                  borderRadius: 10, display: "flex", justifyContent: "space-between", alignItems: "center",
                }}>
                  <span style={{ color: "#4ECCA3", fontWeight: 600, fontSize: 14 }}>{plan.label}</span>
                  <span style={{ color: "#E8EAF0", fontWeight: 700 }}>{fmt(plan.price)}</span>
                </div>
              )}
            </div>

            {/* Name */}
            <div style={{ marginBottom: 16 }}>
              <label style={{ display: "block", fontSize: 12, fontWeight: 600, color: "#8B9FC4", marginBottom: 6, textTransform: "uppercase", letterSpacing: "0.08em" }}>
                Họ và tên *
              </label>
              <input
                type="text" placeholder="Nguyễn Văn A"
                value={form.name}
                onChange={e => { setForm(p => ({ ...p, name: e.target.value })); setErrors(p => ({ ...p, name: "" })); }}
                style={{
                  width: "100%", boxSizing: "border-box",
                  background: "#0A0D14", border: `1.5px solid ${errors.name ? "#FF6B6B" : "#1E2540"}`,
                  borderRadius: 12, padding: "13px 16px", color: "#E8EAF0", fontSize: 14,
                  outline: "none",
                }}
              />
              {errors.name && <div style={{ color: "#FF6B6B", fontSize: 12, marginTop: 4 }}>{errors.name}</div>}
            </div>

            {/* Phone */}
            <div style={{ marginBottom: 16 }}>
              <label style={{ display: "block", fontSize: 12, fontWeight: 600, color: "#8B9FC4", marginBottom: 6, textTransform: "uppercase", letterSpacing: "0.08em" }}>
                Số điện thoại *
              </label>
              <input
                type="tel" placeholder="0901 234 567"
                value={form.phone}
                onChange={e => { setForm(p => ({ ...p, phone: e.target.value })); setErrors(p => ({ ...p, phone: "" })); }}
                style={{
                  width: "100%", boxSizing: "border-box",
                  background: "#0A0D14", border: `1.5px solid ${errors.phone ? "#FF6B6B" : "#1E2540"}`,
                  borderRadius: 12, padding: "13px 16px", color: "#E8EAF0", fontSize: 14,
                  outline: "none",
                }}
              />
              {errors.phone && <div style={{ color: "#FF6B6B", fontSize: 12, marginTop: 4 }}>{errors.phone}</div>}
            </div>

            {/* Note */}
            <div style={{ marginBottom: 24 }}>
              <label style={{ display: "block", fontSize: 12, fontWeight: 600, color: "#8B9FC4", marginBottom: 6, textTransform: "uppercase", letterSpacing: "0.08em" }}>
                Ghi chú (tuỳ chọn)
              </label>
              <textarea
                placeholder="Thời gian rảnh để liên hệ, câu hỏi muốn hỏi..."
                value={form.note}
                onChange={e => setForm(p => ({ ...p, note: e.target.value }))}
                rows={3}
                style={{
                  width: "100%", boxSizing: "border-box",
                  background: "#0A0D14", border: "1.5px solid #1E2540",
                  borderRadius: 12, padding: "13px 16px", color: "#E8EAF0", fontSize: 14,
                  outline: "none", resize: "vertical", fontFamily: "inherit",
                }}
              />
            </div>

            {status === "error" && (
              <div style={{ background: "rgba(255,107,107,0.1)", border: "1px solid rgba(255,107,107,0.3)", borderRadius: 10, padding: "10px 14px", color: "#FF6B6B", fontSize: 13, marginBottom: 16 }}>
                ⚠️ Có lỗi xảy ra. Vui lòng thử lại hoặc liên hệ trực tiếp.
              </div>
            )}

            <button
              onClick={handleSubmit}
              disabled={status === "loading"}
              style={{
                width: "100%", padding: "15px 0", borderRadius: 12, border: "none",
                background: status === "loading"
                  ? "#1E2540"
                  : "linear-gradient(135deg, #4ECCA3 0%, #2A9D8F 100%)",
                color: status === "loading" ? "#8B9FC4" : "#0A0D14",
                fontWeight: 700, fontSize: 15, cursor: status === "loading" ? "not-allowed" : "pointer",
                letterSpacing: "0.04em", transition: "all 0.2s",
              }}
            >
              {status === "loading" ? "Đang gửi..." : "📩 Gửi đăng ký — Tôi muốn được tư vấn"}
            </button>

            <p style={{ textAlign: "center", color: "#4A5568", fontSize: 12, margin: "12px 0 0" }}>
              Mentor sẽ liên hệ bạn qua số điện thoại trong vòng 24 giờ
            </p>
          </>
        )}
      </div>
    </div>
  );
}

